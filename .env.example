# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 用于 /api/interpret（AI 解读）和 /api/heming（合盘分析）。
# 只想排盘、看命盘的话不用填：排盘完全在浏览器本地完成，不需要任何 API Key。
# 未配置时这两个接口返回 503 ai-not-configured，前端会提示「AI 服务未配置」。

# provider 三选一：deepseek / mimo / openai（或 custom 走自建网关）
AI_PROVIDER=deepseek

# ── DeepSeek ──
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：默认 https://api.deepseek.com/v1，模型默认 deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── 或用其他 OpenAI 兼容模型（自建网关 / MiMo 等）───
# AI_PROVIDER=custom
# AI_BASE_URL=https://your-provider/v1
# AI_API_KEY=your-api-key
# AI_MODEL=model-name

# ── 可选：生成参数 ──
# AI_TEMPERATURE=0.8
# AI_MAX_TOKENS=2048

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
